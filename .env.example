# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it's gitignored.

# --- Django database (MySQL) ---
DB_NAME=smart_trip_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- AI provider keys (Decision 0.1) ---
# Claude — used by the Concierge agent (user-facing chat).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=replace-me

# Gemini — used by the Data Architect agent (preference extraction).
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=replace-me

# --- AI agents (optional knobs, Branch A) ---
# Active provider for the Concierge: "anthropic" (default) or "gemini".
# If the chosen provider has no key/SDK, the app uses an offline fallback.
# LLM_PROVIDER=anthropic
# Override the default models if needed.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Django (optional, currently hardcoded in settings.py) ---
# Move SECRET_KEY here when settings.py reads it from env.
# DJANGO_SECRET_KEY=replace-with-a-long-random-string
# DJANGO_DEBUG=True
