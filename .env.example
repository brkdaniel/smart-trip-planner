# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it's gitignored.

# --- Django database (MySQL) ---
DB_NAME=smart_trip_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- AI provider key ---
# Gemini powers both agents (Concierge chat + Data Architect preference
# extraction). Without it, the app falls back to an offline demo client.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=replace-me

# --- AI agents (optional knobs, Branch A) ---
# Override the default model if needed.
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- A3.4: real flight/hotel data via RapidAPI (optional) ---
# Hotels (booking-com18) and flights (google-flights2) are separate RapidAPI
# listings with separate subscriptions, so each may need its own key. Without
# these the Concierge still works, answering with estimates instead of live data.
# RAPIDAPI_KEY=replace-me                # hotels listing (booking-com18)
# RAPIDAPI_HOTELS_HOST=booking-com18.p.rapidapi.com
# RAPIDAPI_FLIGHTS_HOST=google-flights2.p.rapidapi.com
# RAPIDAPI_FLIGHTS_KEY=replace-me        # flights listing; falls back to RAPIDAPI_KEY if unset

# --- Django (optional, currently hardcoded in settings.py) ---
# Move SECRET_KEY here when settings.py reads it from env.
# DJANGO_SECRET_KEY=replace-with-a-long-random-string
# DJANGO_DEBUG=True
